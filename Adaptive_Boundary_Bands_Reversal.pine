//@version=6
strategy("Adaptive Boundary Bands Reversal", shorttitle = "ABB Reversal", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_contract, commission_value = 0.15, process_orders_on_close = true, max_bars_back = 1000)

// =============================================================================
// Adaptive Boundary Bands Reversal  (v1, under test - not trading advice)
// -----------------------------------------------------------------------------
// Bollinger-style bands whose width adapts to the market:
//   - Ranging (low efficiency ratio): bands tighten toward the "ranging" width.
//   - Trending (high efficiency ratio): bands widen toward the "trending" width.
// Efficiency ratio = net move over N bars / total bar-to-bar movement (0..1).
//
// Signal: price pops outside a band, then comes back inside -> fade it.
//   "Close out, then back in": a bar closes outside, the next bar closes inside.
//   "Wick out, close in": a bar wicks outside but closes back inside.
// Stop beyond the pop extreme; target the basis (mean) or an R multiple.
//
// Commission is set to 0.15 per contract per fill (0.30 round trip), a rough
// gold spread. Change it under Properties for other markets.
// The grid table tests 9 band-width combinations inside the script with the
// same rules, so one load compares them. Grid results use the cost input.
// =============================================================================

// ---------------- Inputs ----------------
grpB      = "Adaptive bands"
basisType = input.string("SMA", "Basis", options = ["SMA", "EMA"], group = grpB)
len       = input.int(20, "Length", minval = 5, group = grpB)
erLen     = input.int(20, "Trend/range lookback (efficiency ratio bars)", minval = 5, group = grpB)
erSmooth  = input.int(5, "Efficiency ratio smoothing", minval = 1, group = grpB)
kMin      = input.float(1.5, "Band width when ranging (x stdev)", minval = 0.5, step = 0.1, group = grpB)
kMax      = input.float(3.0, "Band width when trending (x stdev)", minval = 0.5, step = 0.1, group = grpB)

grpS      = "Reversal signal"
popMode   = input.string("Close out, then back in", "Pop type", options = ["Close out, then back in", "Wick out, close in"], group = grpS)
useEr     = input.bool(true, "Only fade when ranging (efficiency ratio at or below max)", group = grpS)
erMax     = input.float(0.35, "Max efficiency ratio to fade", minval = 0.0, maxval = 1.0, step = 0.05, group = grpS)
allowLong = input.bool(true, "Longs (pop below lower band)", group = grpS)
allowShrt = input.bool(true, "Shorts (pop above upper band)", group = grpS)

grpX      = "Exits"
exitMode  = input.string("Basis", "Target", options = ["Basis", "R multiple"], group = grpX)
rr        = input.float(1.5, "R multiple (if Target = R multiple)", minval = 0.5, step = 0.1, group = grpX)
stopBuf   = input.float(0.25, "Stop buffer beyond the pop extreme (x ATR 14)", minval = 0.0, step = 0.05, group = grpX)
maxBars   = input.int(48, "Time exit after N bars", minval = 1, group = grpX)

grpG      = "Parameter grid"
showGrid  = input.bool(true, "Show grid results table", group = grpG)
costPts   = input.float(0.30, "Grid: round-trip cost per trade (price units)", minval = 0.0, step = 0.05, group = grpG)
startTime = input.time(timestamp("2000-01-01T00:00:00"), "Test from", group = grpG)

// ---------------- Core ----------------
basis = basisType == "EMA" ? ta.ema(close, len) : ta.sma(close, len)
dev   = ta.stdev(close, len)
atr   = ta.atr(14)

netMove  = math.abs(close - close[erLen])
pathMove = math.sum(math.abs(close - close[1]), erLen)
erRaw    = pathMove > 0 ? netMove / pathMove : 0.0
erS      = ta.ema(erRaw, erSmooth)
erC      = na(erS) ? na : math.max(0.0, math.min(1.0, erS))

k     = kMin + (kMax - kMin) * nz(erC)
upper = basis + k * dev
lower = basis - k * dev

ranging = not useEr or (not na(erC) and erC <= erMax)
inWin   = time >= startTime
ready   = not na(dev) and not na(erC) and not na(atr)

isCloseMode = popMode == "Close out, then back in"
shortSig = ready and ranging and allowShrt and (isCloseMode ? (close[1] > upper[1] and close < upper) : (high > upper and close < upper))
longSig  = ready and ranging and allowLong and (isCloseMode ? (close[1] < lower[1] and close > lower) : (low < lower and close > lower))

// ---------------- Strategy (uses the inputs above) ----------------
var int entryBar = na
if strategy.position_size == 0 and inWin
    if shortSig
        float sl = math.max(high, high[1]) + stopBuf * atr
        float tp = exitMode == "Basis" ? basis : close - rr * (sl - close)
        if tp < close and sl > close
            strategy.entry("Short", strategy.short)
            strategy.exit("Short exit", "Short", stop = sl, limit = tp)
            entryBar := bar_index
    else if longSig
        float sl = math.min(low, low[1]) - stopBuf * atr
        float tp = exitMode == "Basis" ? basis : close + rr * (close - sl)
        if tp > close and sl < close
            strategy.entry("Long", strategy.long)
            strategy.exit("Long exit", "Long", stop = sl, limit = tp)
            entryBar := bar_index
if strategy.position_size != 0 and not na(entryBar) and bar_index - entryBar >= maxBars
    strategy.close_all(comment = "Time exit")

// ---------------- Plots ----------------
bandCol = color.from_gradient(nz(erC), 0.0, 1.0, color.new(color.teal, 0), color.new(color.orange, 0))
pU = plot(upper, "Upper band", color = bandCol, linewidth = 2)
pL = plot(lower, "Lower band", color = bandCol, linewidth = 2)
plot(basis, "Basis", color = color.new(color.gray, 30))
fill(pU, pL, color = ranging ? color.new(color.teal, 92) : color.new(color.orange, 94), title = "Band fill (teal = ranging, orange = trending)")
plotshape(shortSig and barstate.isconfirmed, "Pop short", shape.triangledown, location.abovebar, color.red, size = size.small)
plotshape(longSig and barstate.isconfirmed, "Pop long", shape.triangleup, location.belowbar, color.lime, size = size.small)

// ---------------- Parameter grid (9 combos, same rules, simulated in-script) ----------------
var array<float> gMinK = array.from(1.0, 1.5, 2.0)
var array<float> gMaxK = array.from(2.5, 3.0, 3.5)
N = 9
var array<int>   gPos    = array.new_int(N, 0)
var array<float> gEnt    = array.new_float(N, 0.0)
var array<float> gSL     = array.new_float(N, 0.0)
var array<float> gTP     = array.new_float(N, 0.0)
var array<int>   gBar    = array.new_int(N, 0)
var array<float> gPrevU  = array.new_float(N, na)
var array<float> gPrevL  = array.new_float(N, na)
var array<int>   gTrades = array.new_int(N, 0)
var array<int>   gWins   = array.new_int(N, 0)
var array<float> gGW     = array.new_float(N, 0.0)
var array<float> gGL     = array.new_float(N, 0.0)

if showGrid and ready
    for i = 0 to N - 1
        float km = array.get(gMinK, math.floor(i / 3))
        float kx = array.get(gMaxK, i % 3)
        float kk = km + (kx - km) * erC
        float up = basis + kk * dev
        float lo = basis - kk * dev
        // manage an open simulated trade (stop checked before target)
        int pos = array.get(gPos, i)
        if pos != 0
            float ent = array.get(gEnt, i)
            float sl  = array.get(gSL, i)
            float tp  = array.get(gTP, i)
            float res = na
            if pos == 1
                res := low <= sl ? sl - ent : high >= tp ? tp - ent : bar_index - array.get(gBar, i) >= maxBars ? close - ent : na
            else
                res := high >= sl ? ent - sl : low <= tp ? ent - tp : bar_index - array.get(gBar, i) >= maxBars ? ent - close : na
            if not na(res)
                res -= costPts
                array.set(gTrades, i, array.get(gTrades, i) + 1)
                if res > 0
                    array.set(gWins, i, array.get(gWins, i) + 1)
                    array.set(gGW, i, array.get(gGW, i) + res)
                else
                    array.set(gGL, i, array.get(gGL, i) - res)
                array.set(gPos, i, 0)
        // new simulated entry
        float pu = array.get(gPrevU, i)
        float pl = array.get(gPrevL, i)
        bool sS = isCloseMode ? (not na(pu) and close[1] > pu and close < up) : (high > up and close < up)
        bool sL = isCloseMode ? (not na(pl) and close[1] < pl and close > lo) : (low < lo and close > lo)
        if array.get(gPos, i) == 0 and inWin and ranging
            if sS and allowShrt
                float sl2 = math.max(high, high[1]) + stopBuf * atr
                float tp2 = exitMode == "Basis" ? basis : close - rr * (sl2 - close)
                if tp2 < close and sl2 > close
                    array.set(gPos, i, -1)
                    array.set(gEnt, i, close)
                    array.set(gSL, i, sl2)
                    array.set(gTP, i, tp2)
                    array.set(gBar, i, bar_index)
            else if sL and allowLong
                float sl3 = math.min(low, low[1]) - stopBuf * atr
                float tp3 = exitMode == "Basis" ? basis : close + rr * (close - sl3)
                if tp3 > close and sl3 < close
                    array.set(gPos, i, 1)
                    array.set(gEnt, i, close)
                    array.set(gSL, i, sl3)
                    array.set(gTP, i, tp3)
                    array.set(gBar, i, bar_index)
        array.set(gPrevU, i, up)
        array.set(gPrevL, i, lo)

var table gt = table.new(position.bottom_right, 7, N + 2, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)
if showGrid and barstate.islast
    table.cell(gt, 0, 0, "Grid: " + popMode + " / target " + exitMode + (useEr ? " / ER<=" + str.tostring(erMax) : ""), text_color = color.white, text_size = size.tiny)
    table.merge_cells(gt, 0, 0, 6, 0)
    hdr = array.from("Range k", "Trend k", "Trades", "Win %", "Profit factor", "Net (price)", "Avg/trade")
    for c = 0 to 6
        table.cell(gt, c, 1, array.get(hdr, c), text_color = color.silver, text_size = size.tiny)
    for i = 0 to N - 1
        float km = array.get(gMinK, math.floor(i / 3))
        float kx = array.get(gMaxK, i % 3)
        int   t  = array.get(gTrades, i)
        float gw = array.get(gGW, i)
        float gl = array.get(gGL, i)
        float net = gw - gl
        float pf  = gl > 0 ? gw / gl : na
        bool  cur = km == kMin and kx == kMax
        color tc  = cur ? color.yellow : color.white
        table.cell(gt, 0, i + 2, str.tostring(km), text_color = tc, text_size = size.tiny)
        table.cell(gt, 1, i + 2, str.tostring(kx), text_color = tc, text_size = size.tiny)
        table.cell(gt, 2, i + 2, str.tostring(t), text_color = tc, text_size = size.tiny)
        table.cell(gt, 3, i + 2, t > 0 ? str.tostring(100.0 * array.get(gWins, i) / t, "0.0") : "-", text_color = tc, text_size = size.tiny)
        table.cell(gt, 4, i + 2, na(pf) ? "-" : str.tostring(pf, "0.00"), text_color = na(pf) ? tc : pf >= 1.3 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size = size.tiny)
        table.cell(gt, 5, i + 2, str.tostring(net, "0.00"), text_color = net > 0 ? color.lime : color.red, text_size = size.tiny)
        table.cell(gt, 6, i + 2, t > 0 ? str.tostring(net / t, "0.00") : "-", text_color = tc, text_size = size.tiny)
